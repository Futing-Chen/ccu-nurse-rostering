# ==========================================
# 1. 資料庫連線設定 (MySQL 與 FastAPI 串接用)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password  # 請在此填入你的 MySQL 資料庫密碼
DB_NAME=ccu_nurse_rostering          # 請將你的資料庫命名為 ccu_nurse_rostering

# ==========================================
# 2. API 伺服器設定 (n8n、Streamlit 串接用)
# ==========================================
API_BASE_URL=http://127.0.0.1:8000
